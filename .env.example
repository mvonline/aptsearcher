# SerpApi — https://serpapi.com/manage-api-key
SERPAPI_KEY=

# "anthropic" (Claude API — needs ANTHROPIC_API_KEY + billing credits, fast)
# or "ollama" (local model via `ollama serve` — free, much slower, no key needed)
LLM_PROVIDER=anthropic

# Anthropic — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# claude-sonnet-5 for quality, claude-haiku-4-5-20251001 for cheap frequent runs
ANTHROPIC_MODEL=claude-sonnet-5

# Only used when LLM_PROVIDER=ollama. Model must already be pulled
# (`ollama pull <model>`) and `ollama serve` must be running.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:latest

# Telegram — message @BotFather to create a bot, then message your bot once
# and hit https://api.telegram.org/bot<token>/getUpdates to read your chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Path to the SQLite DB (created automatically on first run)
DB_PATH=data/listings.db

# Search + filter criteria
CITY=Stockholm
MIN_PRICE_SEK=5000000
MAX_PRICE_SEK=6000000
TARGET_COMPLETION_YEARS=2028,2029

# How many top-ranked new listings to push per run
TOP_N=10

# true = bypass llm.py entirely, use regex year/price scan instead (src/heuristics.py).
# Useful for sanity-checking what search+scrape find before spending LLM calls on them.
SKIP_LLM=false

# Safety cap on total candidates processed per run — hub pages (e.g.
# besqab.se/stockholm/) expand into dozens of sub-links each.
MAX_CANDIDATES_PER_RUN=150
